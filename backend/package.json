{
  "name": "nutri-app-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.runtime.json src/server.ts",
    "dev:once": "tsx --tsconfig tsconfig.runtime.json src/server.ts",
    "dev:stable": "npm run build && node dist/server.js",
    "start": "node dist/server.js",
    "build": "node scripts/build-render-runtime-wrapper.mjs",
    "build:goal-navigator-bundle": "tsx --tsconfig tsconfig.runtime.json scripts/build-goal-navigator-candidate-bundle.ts",
    "test": "tsx --tsconfig tsconfig.runtime.json --test tests/*.test.mjs",
    "cleanup:supabase": "tsx --tsconfig tsconfig.runtime.json scripts/cleanup-supabase-caches.ts"
  },
  "dependencies": {
    "@google-cloud/vision": "^5.3.5",
    "@sentry/node": "^8.55.1",
    "@supabase/supabase-js": "^2.104.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "typescript": "^5.4.5"
  }
}
