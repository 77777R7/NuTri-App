PORT=3001
GOOGLE_CSE_API_KEY=your-google-key
GOOGLE_CSE_CX=your-google-cx
DEEPSEEK_API_KEY=your-deepseek-key
# Optional overrides
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
SECONDARY_SEARCH_ENABLE=1
SECONDARY_SEARCH_TOTAL_BUDGET_MS=10000
SECONDARY_SEARCH_GOOGLE_TIMEOUT_MS=3500
SECONDARY_CHEAP_PASS_MAX_URLS=4
SECONDARY_CHEAP_PASS_TIMEOUT_MS=900
SECONDARY_CHEAP_PASS_MAX_BYTES=16384
SECONDARY_DEEP_FETCH_MAX_PAGES=1
SECONDARY_DEEP_FETCH_TIMEOUT_MS=1000
SECONDARY_FACTS_MIN_COVERAGE=0.55
SECONDARY_LLM_TIMEOUT_MS=8000
SECONDARY_LLM_BUDGET_MS=10000
SECONDARY_QUERY_TOKEN_LIMIT=10
SECONDARY_EXCLUDE_RETAILERS=1
SECONDARY_ALLOW_MARKETPLACE=0
NEGATIVE_TTL_MARKETPLACE_ONLY_MS=43200000

# Barcode contract / write policy rollout flags
# KEY_CONTRACT_V2: off | shadow | enforce
KEY_CONTRACT_V2=shadow
# WRITE_GUARD_V2: off | shadow | enforce
WRITE_GUARD_V2=shadow
# STAGE0 protocol unification: 1 = enabled, 0 = disabled
STAGE0_PROTOCOL_UNIFIED=1
# Metadata endpoint default write behavior: 1 = read-only (recommended)
METADATA_READONLY=1
