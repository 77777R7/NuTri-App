{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "preview_dashboard_static": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_FORCE_FULL_DASHBOARD_EFFECTS": "0",
        "EXPO_PUBLIC_SCAN_DASHBOARD_BISECT": "no_mini_header,no_reanimated_scroll,no_tile_anim"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6759846833"
      }
    }
  }
}
