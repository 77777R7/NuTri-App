# --- Supabase ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# --- Application APIs ---
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001
# Dedicated search backend (falls back to API_BASE if omitted)
EXPO_PUBLIC_SEARCH_API_BASE_URL=http://localhost:3001
# Optional port override for auto-discovery in development
EXPO_PUBLIC_API_PORT=3001
# Frontend terminal state lock runtime fallback (backend flag has precedence)
EXPO_PUBLIC_SCAN_TERMINAL_LOCK_ENABLED=0
SCAN_TERMINAL_LOCK_ENABLED=0

# Barcode rollout flags (backend reads these too when present in root .env)
KEY_CONTRACT_V2=shadow
WRITE_GUARD_V2=shadow
STAGE0_PROTOCOL_UNIFIED=1
METADATA_READONLY=1

# --- Monitoring & Analytics ---
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
POSTHOG_API_KEY=phc_example_posthog_api_key

# --- RevenueCat / Pro Purchases ---
# iOS public SDK API key from RevenueCat. App Store products:
# nutri_pro_monthly, nutri_pro_yearly. Entitlement: pro. Offering: default.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_YOUR_REVENUECAT_IOS_PUBLIC_KEY
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro

# --- Expo / EAS ---
EAS_PROJECT_ID=

# --- Scan Dashboard Dev Build Toggles (optional) ---
# Set to 1 to force-enable full iOS dev dashboard visuals during local QA.
EXPO_PUBLIC_FORCE_IOS_DEV_DASHBOARD_ANIMATIONS=0
EXPO_PUBLIC_FORCE_IOS_DEV_SCORE_RING=0
