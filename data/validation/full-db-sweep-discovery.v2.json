      "note": "nightly_sparse_honesty"
    },
    {
      "bucket": "food_like_boundary",
      "limit": 3,
      "note": "nightly_route_honesty"
    },
    {
      "bucket": "source_whey_dairy",
      "limit": 2,
      "note": "stable_persona_source"
    },
    {
      "bucket": "source_soy",
      "limit": 2,
      "note": "stable_persona_source"
    },
    {
      "bucket": "omega_shellfish_source",
      "limit": 2,
      "note": "stable_persona_source"
    }
  ],
  "outDir": "output/validation-discovery"
}
