      "note": "Check route honesty across drink mix, gel, and bar products."
    },
    {
      "bucket": "source_whey_dairy",
      "note": "Promote explicit dairy/source-sensitive runtime checks."
    },
    {
      "bucket": "source_soy",
      "note": "Promote explicit soy/source-sensitive runtime checks."
    },
    {
      "bucket": "omega_shellfish_source",
      "note": "Promote shellfish-aware omega source checks."
    },
    {
      "bucket": "probiotic_trade_name",
      "note": "Promote named probiotic alias coverage."
    },
    {
      "bucket": "omega_algal_source",
      "note": "Promote source-family omega copy checks."
    },
    {
      "bucket": "duplicate_stack_cal_mag",
      "note": "Promote mineral stack counterfactuals."
    }
  ],
  "promotionCandidatesByBucket": [
    {
      "bucket": "facts_short_1_3",
