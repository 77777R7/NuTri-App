{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nutri.app/schemas/personalization/explanation_templates.schema.json",
  "type": "object",
  "required": ["version", "templates"],
  "properties": {
    "version": { "type": "string", "const": "v1" },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "template", "placeholders"],
        "properties": {
          "code": { "type": "string" },
          "template": { "type": "string" },
          "placeholders": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
