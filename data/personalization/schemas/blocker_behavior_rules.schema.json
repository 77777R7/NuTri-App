{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nutri.app/schemas/personalization/blocker_behavior_rules.schema.json",
  "type": "object",
  "required": ["version", "blockerStrategies"],
  "properties": {
    "version": { "type": "string", "const": "v1" },
    "blockerStrategies": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["key", "onboardingLabel", "blockerMode", "reminderPriority", "scheduleComplexity", "notificationBudget", "emphasizeHomeCheckIn", "emphasizeScheduleSetup", "emphasizeExplanation", "preferredTimingAnchors"],
        "properties": {
          "key": { "type": "string", "enum": ["busy_day_forgetfulness", "routine_changes_day_to_day", "goal_fit_uncertainty", "label_and_dosage_confusion", "weak_tracking_habit", "already_consistent"] },
          "onboardingLabel": {
            "type": "string",
            "enum": [
              "I forget when my day gets busy",
              "My routine changes day to day",
              "I am not sure which supplements fit my goals",
              "Labels and dosage are confusing",
              "I do not have a good daily tracking habit",
              "I am already consistent"
            ]
          },
          "blockerMode": { "type": "string", "minLength": 1 },
          "reminderPriority": { "type": "string", "enum": ["high", "medium", "low"] },
          "scheduleComplexity": { "type": "string", "enum": ["simple", "guided", "advanced"] },
          "notificationBudget": { "type": "string", "enum": ["light", "standard", "heavy"] },
          "emphasizeHomeCheckIn": { "type": "boolean" },
          "emphasizeScheduleSetup": { "type": "boolean" },
          "emphasizeExplanation": { "type": "boolean" },
          "preferredTimingAnchors": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
