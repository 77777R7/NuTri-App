{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nutri.app/schemas/personalization/evidence_graph.v1.schema.json",
  "type": "object",
  "required": ["version", "ingredientNodes", "goalNodes", "ingredientGoalEdges", "formulaPatterns"],
  "properties": {
    "version": { "type": "string", "const": "v1" },
    "ingredientNodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ingredientKey", "label"],
        "properties": {
          "ingredientKey": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "goalNodes": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["goalKey", "label"],
        "properties": {
          "goalKey": {
            "type": "string",
            "enum": ["sleep", "energy", "immunity", "recovery", "focus", "libido_enhancement", "stress_support", "weight_management"]
          },
          "label": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "ingredientGoalEdges": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["ingredientKey", "goalKey", "relation", "evidenceTier", "baseWeight", "minDoseHint", "doseUnit", "provenance"],
        "properties": {
          "ingredientKey": { "type": "string", "minLength": 1 },
          "goalKey": {
            "type": "string",
            "enum": ["sleep", "energy", "immunity", "recovery", "focus", "libido_enhancement", "stress_support", "weight_management"]
          },
          "relation": { "type": "string", "const": "supports_goal" },
          "evidenceTier": { "type": "string", "enum": ["A", "B", "C", "D"] },
          "baseWeight": { "type": "number", "minimum": 0 },
          "minDoseHint": { "type": "number", "minimum": 0 },
          "doseUnit": { "type": "string", "enum": ["mcg", "mg", "g"] },
          "maxUsefulDoseHint": { "type": ["number", "null"], "minimum": 0 },
          "formConstraint": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "notes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "caps": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "enum": ["eligibility_requires_generic_safety_path"] }
          },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["sourceType", "sourceKey", "title"],
              "properties": {
                "sourceType": {
                  "type": "string",
                  "enum": ["ontology_migration", "review_article", "systematic_review", "clinical_guideline", "internal_curation"]
                },
                "sourceKey": { "type": "string", "minLength": 1 },
                "title": { "type": "string", "minLength": 1 },
                "citation": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "minLength": 1 },
                "note": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "formulaPatterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["goalKey", "requiredIngredients", "bonusWeight", "reasonCodes", "provenance"],
        "properties": {
          "goalKey": {
            "type": "string",
            "enum": ["sleep", "energy", "immunity", "recovery", "focus", "libido_enhancement", "stress_support", "weight_management"]
          },
          "requiredIngredients": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "optionalIngredients": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "bonusWeight": { "type": "number", "minimum": 0 },
          "reasonCodes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["sourceType", "sourceKey", "title"],
              "properties": {
                "sourceType": {
                  "type": "string",
                  "enum": ["ontology_migration", "review_article", "systematic_review", "clinical_guideline", "internal_curation"]
                },
                "sourceKey": { "type": "string", "minLength": 1 },
                "title": { "type": "string", "minLength": 1 },
                "citation": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "minLength": 1 },
                "note": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
