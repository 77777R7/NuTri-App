{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nutri.app/schemas/personalization/activity_goal_map.schema.json",
  "type": "object",
  "required": ["version", "activityMappings"],
  "properties": {
    "version": { "type": "string", "const": "v1" },
    "activityMappings": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["activityKey", "planKey", "suggestedGoals", "suggestedTypes", "suggestedTimingAnchors"],
        "properties": {
          "activityKey": { "type": "string" },
          "planKey": { "type": "string" },
          "suggestedGoals": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "enum": ["sleep", "energy", "immunity", "recovery", "focus", "libido_enhancement", "stress_support", "weight_management"] }
          },
          "suggestedTypes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "enum": ["vitamin", "mineral", "herb", "probiotic", "protein"] }
          },
          "suggestedTimingAnchors": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
