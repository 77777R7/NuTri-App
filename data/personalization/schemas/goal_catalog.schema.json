{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nutri.app/schemas/personalization/goal_catalog.schema.json",
  "type": "object",
  "required": ["version", "goals"],
  "properties": {
    "version": { "type": "string", "const": "v1" },
    "goals": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "key",
          "goalKey",
          "label",
          "onboardingLabel",
          "aliases",
          "defaultPriority",
          "summary",
          "active",
          "defaultVisible",
          "allowedTypes"
        ],
        "properties": {
          "key": {
            "type": "string",
            "enum": ["sleep", "energy", "immunity", "recovery", "focus", "libido_enhancement", "stress_support", "weight_management"]
          },
          "goalKey": {
            "type": "string",
            "enum": ["sleep", "energy", "immunity", "recovery", "focus", "libido_enhancement", "stress_support", "weight_management"]
          },
          "label": {
            "type": "string",
            "enum": ["Sleep", "Energy", "Immunity", "Recovery", "Focus", "Libido Enhancement", "Stress Support", "Weight Management"]
          },
          "onboardingLabel": {
            "type": "string",
            "enum": ["Sleep", "Energy", "Immunity", "Recovery", "Focus", "Libido Enhancement", "Stress Support", "Weight Management"]
          },
          "aliases": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "defaultPriority": { "type": "integer" },
          "summary": { "type": "string", "minLength": 1 },
          "active": { "type": "boolean" },
          "defaultVisible": { "type": "boolean" },
          "allowedTypes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "enum": ["vitamin", "mineral", "herb", "probiotic", "protein"] }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
