{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nutri.app/schemas/personalization/diet_nutrient_lane_map.schema.json",
  "type": "object",
  "required": ["version", "laneCatalog", "dietMappings"],
  "properties": {
    "version": { "type": "string", "const": "v1" },
    "laneCatalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["laneKey", "label"],
        "properties": {
          "laneKey": { "type": "string" },
          "label": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "dietMappings": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["dietKey", "laneKeys"],
        "properties": {
          "dietKey": { "type": "string" },
          "laneKeys": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
